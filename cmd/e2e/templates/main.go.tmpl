package main

import (
{{- if .Setup.PkgPath }}
	root "{{ .Setup.PkgPath }}"
{{- end }}
{{- if .Setup.Config }}
	_ "{{ .Setup.PkgPath }}/e2e_boot"
{{- end }}
{{- range .Packages }}
{{- if ne .PkgPath $.Setup.PkgPath }}
	{{ .ImportAlias }} "{{ .PkgPath }}"
{{- end }}
{{- end }}
	e2e "github.com/gombrii/go-e2e"
)

func main() {
	e2e.Runner{
	{{- if .Setup.Config }}
		Config: root.{{ .Setup.Config }},
	{{- end }}
		Verbose: {{ .Verbose }},
	}.Run(map[string]e2e.Runnable{
{{- range .Packages }}
	{{- $pkg := . }}
	{{- range .ExportedVars }}
		"{{ .DisplayName }}": {{ $pkg.ImportAlias }}.{{ .VarName }},
	{{- end }}
{{- end }}
	})
}
